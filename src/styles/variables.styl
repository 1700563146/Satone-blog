/* ===== 基础变量定义 ===== */
:root
  /* 卡片圆角：比 1rem 再柔一档，配合淡蓝底色显得轻 */
  --radius-large: 1.25rem
  --content-delay: 150ms

/* ===== 主题相关变量 ===== */

/* 色相体系（两层色相，避免单一色相铺满整个页面）
     --hue      主色相，由 siteConfig.themeColor.hue 或设置面板写入（默认 202：青）
     --hue-alt  恒比主色相冷一档（+30°）的辅助色相：淡蓝。
                 只用于底色、卡片描边、暗部表面与分隔线，让页面读起来是
                 「青色作笔、淡蓝作纸」——主色负责动作与强调，底色负责空气感 */
:root
  --hue-alt: calc(var(--hue) + 30)

  /* 主色：青。亮度压到 0.52：卡片现在是半透明的（有效底色比纯白略暗），
     这个亮度能保证链接 / 图标在「半透明白卡」与「页面底色」上都 ≥ 4.5:1 */
  --primary: oklch(0.52 0.115 var(--hue))
  --primary-hover: oklch(0.46 0.115 var(--hue))
  --primary-soft: oklch(0.955 0.028 var(--hue))
  /* 铺在主色上的文字/图标（实心选中态、实心按钮） */
  --on-primary: white

  /* 底色：淡蓝纸面；卡片纯白，用冷色描边 + 极浅投影分层，而不是靠深灰边框 */
  --page-bg: oklch(0.970 0.014 var(--hue-alt))
  --card-bg: white
  /* 卡片不透明度：< 1 时卡片透出底色与背后的星点（只作用于 .card-base，
     浮层面板 / 按钮仍用不透明的 --card-bg，避免面板里透出正文） */
  --card-alpha: 0.82
  --card-border: oklch(0.912 0.017 var(--hue-alt))
  --card-bg-transparent: unquote("rgb(255 255 255 / var(--card-transparent-opacity, 0.6))")

  --btn-content: oklch(0.46 0.09 var(--hue))
  --btn-regular-bg: oklch(0.966 0.022 var(--hue))
  --btn-regular-bg-hover: oklch(0.933 0.04 var(--hue))
  --btn-regular-bg-active: oklch(0.90 0.055 var(--hue))

  --btn-plain-bg-hover: oklch(0.955 0.026 var(--hue))
  --btn-plain-bg-active: oklch(0.93 0.04 var(--hue))

  --btn-card-bg-hover: oklch(0.976 0.012 var(--hue-alt))
  --btn-card-bg-active: oklch(0.93 0.03 var(--hue))

  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  --deep-text: oklch(0.25 0.025 var(--hue-alt))
  --title-active: oklch(0.50 0.10 var(--hue))

  /* 分隔线也带一点冷色，纯黑描边在淡蓝纸面上会显脏 */
  --line-divider: unquote("oklch(0.50 0.04 var(--hue-alt) / 0.14)")
  --line-color: unquote("oklch(0.50 0.04 var(--hue-alt) / 0.18)")
  --meta-divider: unquote("oklch(0.50 0.04 var(--hue-alt) / 0.28)")
  --content-meta: unquote("oklch(0.40 0.03 var(--hue-alt) / 0.72)")

  --inline-code-bg: var(--btn-regular-bg)
  --inline-code-color: var(--btn-content)
  --muted: oklch(0.955 0.014 var(--hue-alt))
  --selection-bg: oklch(0.88 0.06 var(--hue))
  --codeblock-bg: oklch(0.17 0.015 var(--hue-alt))
  --codeblock-topbar-bg: oklch(0.3 0.02 var(--hue-alt))

  --license-block-bg: unquote("oklch(0.50 0.04 var(--hue-alt) / 0.05)")

  --link-underline: oklch(0.90 0.05 var(--hue))
  --link-hover: oklch(0.95 0.028 var(--hue))
  --link-active: oklch(0.90 0.05 var(--hue))

  --float-panel-bg: white

  /* 卡片层次：极浅投影只用来「抬起来一点」，不制造重量 */
  --shadow-card: unquote("0 1px 2px oklch(0.45 0.04 var(--hue-alt) / 0.07), 0 12px 26px -14px oklch(0.45 0.05 var(--hue-alt) / 0.22)")
  --shadow-card-hover: unquote("0 2px 4px oklch(0.45 0.04 var(--hue-alt) / 0.09), 0 18px 36px -18px oklch(0.45 0.05 var(--hue-alt) / 0.3)")
  
  --scrollbar-bg-light: rgba(0, 0, 0, 0.4)
  --scrollbar-bg-hover-light: rgba(0, 0, 0, 0.5)
  --scrollbar-bg-active-light: rgba(0, 0, 0, 0.6)
  
  --scrollbar-bg-dark: rgba(255, 255, 255, 0.4)
  --scrollbar-bg-hover-dark: rgba(255, 255, 255, 0.5)
  --scrollbar-bg-active-dark: rgba(255, 255, 255, 0.6)
  
  --scrollbar-bg: var(--scrollbar-bg-light)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light)
  
  --display-light-icon: 1
  --display-dark-icon: 0
  
  --admonitions-color-tip: oklch(0.7 0.14 180)
  --admonitions-color-note: oklch(0.7 0.14 250)
  --admonitions-color-important: oklch(0.7 0.14 310)
  --admonitions-color-warning: oklch(0.7 0.14 60)
  --admonitions-color-caution: oklch(0.6 0.2 25)
  
  /* TOC相关变量 */
  --toc-badge-bg: oklch(0.9 0.045 var(--hue))
  --toc-btn-hover: oklch(0.94 0.04 var(--hue))
  --toc-btn-active: oklch(0.91 0.055 var(--hue))
  --toc-indicator-bg: oklch(0.94 0.014 var(--hue-alt))
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: oklch(0.54 0.115 var(--hue))

  /* Live2D 消息框变量 */
  --l2d-msg-bg: oklch(0.54 0.115 var(--hue))

  /* 主题色选择条渐变 */
  --color-selection-bar: linear-gradient(to right, oklch(0.80 0.10 0), oklch(0.80 0.10 30), oklch(0.80 0.10 60), oklch(0.80 0.10 90), oklch(0.80 0.10 120), oklch(0.80 0.10 150), oklch(0.80 0.10 180), oklch(0.80 0.10 210), oklch(0.80 0.10 240), oklch(0.80 0.10 270), oklch(0.80 0.10 300), oklch(0.80 0.10 330), oklch(0.80 0.10 360))

/* 卡片风格跟随主题色相 */
:root:not(.dark) body.card-follow-theme-hue
  --card-bg: oklch(1 0.01 var(--hue))

/* 暗色主题变量
   暗色不是亮色的机械反相：底色走更深的蓝调（--hue-alt），卡片比底浅一档形成层次，
   主色提亮到 0.78 保证在深底上仍然醒目 */
:root.dark
  --primary: oklch(0.78 0.115 var(--hue))
  --primary-hover: oklch(0.84 0.10 var(--hue))
  --primary-soft: oklch(0.30 0.04 var(--hue))
  /* 暗色主色偏亮，铺在主色上的文字改用深墨，避免白字在亮青上糊成一片
     （--deep-text 语义就是「压深墨色」，暗色下不反转，见 StepItem/TimelineItem 的局部覆盖） */
  --on-primary: var(--deep-text)
  --page-bg: oklch(0.165 0.017 var(--hue-alt))
  --card-bg: oklch(0.225 0.017 var(--hue-alt))
  /* 暗色下更透一点，让背后的星点隐约透出来（卡片仍是阅读表面，不能再低） */
  --card-alpha: 0.74
  --card-border: unquote("oklch(0.95 0.02 var(--hue-alt) / 0.10)")
  --card-bg-transparent: unquote("rgb(23 23 23 / var(--card-transparent-opacity, 0.6))")

  /* 导航栏玻璃高光与发丝线（暗色） */
  --navbar-glass-highlight: rgba(255, 255, 255, 0.06)
  --navbar-glass-hairline: rgba(255, 255, 255, 0.10)

  --btn-content: oklch(0.80 0.09 var(--hue))
  --btn-regular-bg: oklch(0.31 0.032 var(--hue))
  --btn-regular-bg-hover: oklch(0.36 0.038 var(--hue))
  --btn-regular-bg-active: oklch(0.41 0.042 var(--hue))

  --btn-plain-bg-hover: oklch(0.29 0.03 var(--hue))
  --btn-plain-bg-active: oklch(0.26 0.024 var(--hue))

  --btn-card-bg-hover: oklch(0.29 0.026 var(--hue-alt))
  --btn-card-bg-active: oklch(0.34 0.03 var(--hue))

  /* --deep-text 保持深墨（不随暗色反转）：它同时是「亮色面板上的墨色」，
     如分类计数徽标 dark:bg-(--primary) + dark:text-(--deep-text) */
  --line-divider: unquote("oklch(0.95 0.02 var(--hue-alt) / 0.10)")
  --line-color: unquote("oklch(0.95 0.02 var(--hue-alt) / 0.13)")
  --meta-divider: unquote("oklch(0.95 0.02 var(--hue-alt) / 0.24)")
  --content-meta: unquote("oklch(0.95 0.02 var(--hue-alt) / 0.62)")

  --muted: oklch(0.26 0.016 var(--hue-alt))
  --selection-bg: oklch(0.40 0.08 var(--hue))
  --codeblock-bg: oklch(0.17 0.015 var(--hue-alt))
  --codeblock-topbar-bg: oklch(0.12 0.015 var(--hue-alt))

  --license-block-bg: var(--codeblock-bg)

  --link-underline: oklch(0.45 0.09 var(--hue))
  --link-hover: oklch(0.45 0.09 var(--hue))
  --link-active: oklch(0.38 0.08 var(--hue))

  --float-panel-bg: oklch(0.20 0.017 var(--hue-alt))

  /* 暗色投影更依赖黑色，但保留一点冷调避免发黄 */
  --shadow-card: unquote("0 1px 3px rgb(0 0 0 / 0.4), 0 14px 30px -18px rgb(0 0 0 / 0.65)")
  --shadow-card-hover: unquote("0 2px 8px rgb(0 0 0 / 0.45), 0 20px 44px -20px rgb(0 0 0 / 0.75)")
  
  --scrollbar-bg: var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-dark)
  
  --display-light-icon: 0
  --display-dark-icon: 1
  
  --admonitions-color-tip: oklch(0.75 0.14 180)
  --admonitions-color-note: oklch(0.75 0.14 250)
  --admonitions-color-important: oklch(0.75 0.14 310)
  --admonitions-color-warning: oklch(0.75 0.14 60)
  --admonitions-color-caution: oklch(0.65 0.2 25)
  
  /* TOC相关变量 - 暗色主题 */
  --toc-badge-bg: var(--btn-regular-bg)
  --toc-btn-hover: oklch(0.28 0.04 var(--hue))
  --toc-btn-active: oklch(0.32 0.05 var(--hue))
  --toc-indicator-bg: oklch(0.28 0.035 var(--hue-alt))
  --toc-item-active: oklch(0.78 0.115 var(--hue))

  /* Live2D 消息框变量 - 暗色主题 */
  --l2d-msg-bg: oklch(0.35 0.08 var(--hue))

  /* 主题色选择条渐变 - 暗色主题 */
  --color-selection-bar: linear-gradient(to right, oklch(0.70 0.10 0), oklch(0.70 0.10 30), oklch(0.70 0.10 60), oklch(0.70 0.10 90), oklch(0.70 0.10 120), oklch(0.70 0.10 150), oklch(0.70 0.10 180), oklch(0.70 0.10 210), oklch(0.70 0.10 240), oklch(0.70 0.10 270), oklch(0.70 0.10 300), oklch(0.70 0.10 330), oklch(0.70 0.10 360))

/* ===== 响应式断点变量 ===== */
:root
  /* 断点定义 */
  --breakpoint-xs: 320px
  --breakpoint-sm: 480px
  --breakpoint-md: 768px
  --breakpoint-lg: 1024px
  --breakpoint-xl: 1280px
  --breakpoint-2xl: 1536px
  
  /* 容器宽度 */
  --container-xs: 100%
  --container-sm: 100%
  --container-md: 100%
  --container-lg: 1024px
  --container-xl: 1280px
  --container-2xl: 1536px

/* ===== 动画变量 ===== */
:root
  /* 缓动函数 */
  --ease-standard: cubic-bezier(0.4, 0, 0.2, 1)
  --ease-decelerate: cubic-bezier(0.25, 0.46, 0.45, 0.94)
  --ease-accelerate: cubic-bezier(0.55, 0.055, 0.675, 0.19)
  --ease-sharp: cubic-bezier(0.4, 0, 0.6, 1)
  
  /* 动画时长 */
  --duration-fast: 100ms
  --duration-normal: 150ms
  --duration-medium: 200ms
  --duration-slow: 250ms
  --duration-slower: 300ms
  
  /* 动画延迟 */
  --delay-none: 0ms
  --delay-short: 30ms
  --delay-medium: 60ms
  --delay-long: 90ms
  --delay-longer: 120ms

/* ===== 间距变量 ===== */
:root
  /* 基础间距 */
  --spacing-xs: 0.25rem    /* 4px */
  --spacing-sm: 0.5rem     /* 8px */
  --spacing-md: 0.75rem    /* 12px */
  --spacing-lg: 1rem       /* 16px */
  --spacing-xl: 1.25rem    /* 20px */
  --spacing-2xl: 1.5rem    /* 24px */
  --spacing-3xl: 2rem      /* 32px */
  --spacing-4xl: 2.5rem    /* 40px */
  --spacing-5xl: 3rem      /* 48px */
  
  /* 组件间距 */
  --widget-gap-mobile: var(--spacing-md)
  --widget-gap-tablet: var(--spacing-lg)
  --widget-gap-desktop: var(--spacing-xl)
  
  /* 侧边栏宽度 */
  --sidebar-width-mobile: 100%
  --sidebar-width-tablet: 280px
  --sidebar-width-desktop: 320px

/* ===== 阴影变量 ===== */
:root
  /* 基础阴影 */
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05)
  --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.1)
  --shadow-lg: 0 10px 15px rgba(0, 0, 0, 0.1)
  --shadow-xl: 0 20px 25px rgba(0, 0, 0, 0.1)
  --shadow-2xl: 0 25px 50px rgba(0, 0, 0, 0.25)
  
  /* 特殊阴影 */
  --shadow-navbar: 0 4px 16px rgba(0, 0, 0, 0.1)
  --shadow-navbar-dark: 0 4px 16px rgba(0, 0, 0, 0.2)
  --shadow-button: 0 4px 12px rgba(0, 0, 0, 0.15)
  --shadow-button-dark: 0 4px 12px rgba(255, 255, 255, 0.1)

  /* 导航栏玻璃高光与发丝线（明色） */
  --navbar-glass-highlight: rgba(255, 255, 255, 0.18)
  --navbar-glass-hairline: rgba(0, 0, 0, 0.06)

/* ===== 边框半径变量 ===== */
:root
  --radius-sm: 0.25rem     /* 4px */
  --radius-md: 0.375rem    /* 6px */
  --radius-lg: 0.5rem      /* 8px */
  --radius-xl: 0.75rem     /* 12px */
  --radius-2xl: 1rem       /* 16px */
  --radius-3xl: 1.5rem     /* 24px */
  --radius-full: 9999px

/* ===== 透明度变量 ===== */
:root
  --opacity-0: 0
  --opacity-5: 0.05
  --opacity-10: 0.1
  --opacity-20: 0.2
  --opacity-25: 0.25
  --opacity-30: 0.3
  --opacity-40: 0.4
  --opacity-45: 0.45
  --opacity-50: 0.5
  --opacity-55: 0.55
  --opacity-60: 0.6
  --opacity-70: 0.7
  --opacity-75: 0.75
  --opacity-80: 0.8
  --opacity-85: 0.85
  --opacity-90: 0.9
  --opacity-95: 0.95
  --opacity-100: 1

/* ===== 模糊效果变量 ===== */
:root
  --blur-sm: 4px
  --blur-md: 8px
  --blur-lg: 12px
  --blur-xl: 16px
  --blur-2xl: 20px
  --blur-3xl: 24px

/* ===== 变换变量 ===== */
:root
  /* 平移 */
  --translate-xs: 0.125rem   /* 2px */
  --translate-sm: 0.25rem     /* 4px */
  --translate-md: 0.5rem      /* 8px */
  --translate-lg: 0.75rem     /* 12px */
  --translate-xl: 1rem        /* 16px */
  --translate-2xl: 1.5rem      /* 24px */
  --translate-3xl: 2rem       /* 32px */
  
  /* 缩放 */
  --scale-95: 0.95
  --scale-98: 0.98
  --scale-100: 1
  --scale-105: 1.05
  --scale-110: 1.1

/* ===== 层级变量 ===== */
:root
  --z-dropdown: 1000
  --z-sticky: 1020
  --z-fixed: 1030
  --z-modal-backdrop: 1040
  --z-modal: 1050
  --z-popover: 1060
  --z-tooltip: 1070
  --z-toast: 1080
  --z-navbar: 20
  --z-banner: 10
  --z-content: 30

/* ===== 性能优化变量 ===== */
:root
  /* GPU加速 */
  --gpu-transform: translateZ(0)
  --gpu-backface: hidden
  
  /* 动画性能 */
  --animation-fill-mode: both
  --animation-timing: var(--ease-standard)
  --animation-duration: var(--duration-medium)

/* ===== 响应式工具类 ===== */
@media (max-width: 767px)
  :root
    --container-width: var(--container-sm)
    --widget-gap: var(--widget-gap-mobile)

@media (min-width: 768px) and (max-width: 1279px)
  :root
    --container-width: var(--container-md)
    --widget-gap: var(--widget-gap-tablet)

@media (min-width: 1280px)
  :root
    --container-width: var(--container-lg)
    --widget-gap: var(--widget-gap-desktop)
