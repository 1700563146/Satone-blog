---
// 星空开关：悬浮控件里的一个星形按钮，暗色主题下切换背景星空
//
// 为什么放在悬浮控件而不是导航栏：导航栏在小屏已经挤了搜索/音乐/主题/菜单四个图标，
// 星空属于「特效开关」，和目录、沉浸阅读、回到顶部是同一类浮层操作。
// 亮色主题下星点不渲染，按钮同步隐藏（不做无效果的死控件）。
// 与设置面板里的「星空背景」开关共用同一个 localStorage key（starfieldEnabled）。
import FloatingButton from "@/components/common/FloatingButton.astro";
import { interactiveEffectsConfig } from "@/config/effectsConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

// 只看功能本身是否可用：displaySettingsConfig 的总开关管的是「设置面板」，
// 面板在默认配置里是关的（省产物体积），不能让星空开关跟着一起消失
const enable = interactiveEffectsConfig.starfield.enable;
const showToggle =
	typeof enable === "boolean" ? enable : (enable.desktop ?? false);
---

{
	showToggle && (
		<FloatingButton
			id="starfield-toggle-btn"
			icon="material-symbols:auto-awesome-outline"
			toggleIcon="material-symbols:auto-awesome"
			ariaLabel={i18n(I18nKey.starfieldEffect)}
			class="toggled"
		/>
	)
}

<style is:global>
	/* 亮色主题没有星点，按钮也不出现（display 直接收起，不占位）。
	     必须是全局样式：按钮由 FloatingButton 渲染，带不上本组件的 scoped 标记 */
	html:not(.dark) #starfield-toggle-btn {
		display: none !important;
	}
</style>

<script>
	import {
		getStoredStarfieldEnabled,
		setStarfieldEnabled,
	} from "@utils/setting-utils";

	(function setupStarfieldToggle() {
		if (window.__starfieldToggleReady) return;
		window.__starfieldToggleReady = true;

		const btn = document.getElementById("starfield-toggle-btn");
		if (!btn) return;

		const sync = (enabled: boolean) => {
			// .toggled 控制图标在「实心星」与「空心星」之间切换
			btn.classList.toggle("toggled", enabled);
			btn.setAttribute("aria-pressed", String(enabled));
			for (const state of ["off", "on"]) btn.removeAttribute(`data-${state}`);
			btn.setAttribute(enabled ? "data-on" : "data-off", "");
		};

		sync(getStoredStarfieldEnabled());

		btn.addEventListener("click", (event) => {
			event.stopPropagation();
			const next = !btn.classList.contains("toggled");
			setStarfieldEnabled(next);
			sync(next);
		});

		// 设置面板里的同名开关可能也改了这个值，保持一致
		window.addEventListener("starfieldToggle", (event: Event) => {
			const detail = (event as CustomEvent<{ enabled: boolean }>).detail;
			if (detail) sync(detail.enabled);
		});
	})();
</script>
