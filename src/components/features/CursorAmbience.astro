---
// 指针氛围层：暗色背景星光点阵（含指针连线） + 鼠标跟随光晕
//
// 层级设计（关键）：
//   html 底色 < canvas(z-1) < 壁纸(z-10) < 光晕(z-25) < 内容区(z-30) < 卡片
// 星点只活在页面空白处，光晕铺在壁纸上但永远在卡片之下，
// 因此两者都不会糊到正文或卡片上。
// 逐帧代价：星点上限 64 颗（约 2k 次距离判断/帧）+ 一个固定尺寸的混合层，
// 且仅在「暗色 + 可见 + 未减弱动态」时启动；否则完全不占帧。
import { interactiveEffectsConfig } from "@/config";

const { starfield, cursorGlow } = interactiveEffectsConfig;

const starfieldAnyDevice =
	starfield.enable === true ||
	(typeof starfield.enable === "object" &&
		(starfield.enable.desktop || starfield.enable.mobile));

const glowSize = `${cursorGlow.size}px`;
---

{
	starfieldAnyDevice && (
		<canvas id="starfield-canvas" aria-hidden="true" />
	)
}
{
	cursorGlow.enable && (
		<div
			id="cursor-glow"
			aria-hidden="true"
			style={`--glow-size: ${glowSize}; --glow-opacity-dark: ${cursorGlow.opacityDark}; --glow-opacity-light: ${cursorGlow.opacityLight};`}
		/>
	)
}

<style>
	/* 星点画布：置于页面底色之上、壁纸与内容区之下 */
	#starfield-canvas {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 1;
		pointer-events: none;
		opacity: 0;
		transition: opacity 700ms ease;
	}

	:root.dark #starfield-canvas {
		opacity: 1;
	}

	/* 鼠标跟随光晕：screen 混合只在深色区域显影，白底上自动隐身 */
	#cursor-glow {
		position: fixed;
		top: 0;
		left: 0;
		width: var(--glow-size, 480px);
		height: var(--glow-size, 480px);
		border-radius: 50%;
		z-index: 25;
		pointer-events: none;
		translate: -50% -50%;
		transform: translate3d(-200vw, -200vw, 0);
		opacity: 0;
		transition: opacity 500ms ease;
		will-change: transform, opacity;
		/* 多段衰减，避免单段径向渐变在深色壁纸上出现「圆斑边界」 */
		background: radial-gradient(
			circle closest-side,
			color-mix(in oklch, var(--primary) 62%, transparent) 0%,
			color-mix(in oklch, var(--primary) 40%, transparent) 22%,
			color-mix(in oklch, var(--primary) 22%, transparent) 40%,
			color-mix(in oklch, var(--primary) 10%, transparent) 58%,
			color-mix(in oklch, var(--primary) 4%, transparent) 76%,
			transparent 100%
		);
		mix-blend-mode: screen;
	}

	#cursor-glow[data-visible="true"] {
		opacity: var(--glow-opacity-light, 0.24);
	}

	:root.dark #cursor-glow[data-visible="true"] {
		opacity: var(--glow-opacity-dark, 0.5);
	}

	/* 减弱动态：光晕直接不出现，星点由脚本静态绘制 */
	@media (prefers-reduced-motion: reduce) {
		#cursor-glow {
			display: none;
		}
	}
</style>

<script>
	import { interactiveEffectsConfig } from "@/config";

	type Star = {
		x: number;
		y: number;
		vx: number;
		vy: number;
		r: number;
		alpha: number;
		phase: number;
		twinkle: number;
		color: number; // 调色板索引
		glow: number; // 光晕半径倍率（大节点更亮更大）
		warm: boolean; // 暖色星（琥珀/珊瑚），整片星空里只留几颗
	};

	/** 背景繁星：数量多、体积小，不参与任何连线，只负责「璀璨」的底噪 */
	type BgStar = {
		x: number;
		y: number;
		vx: number;
		vy: number;
		r: number;
		alpha: number;
		phase: number;
		twinkle: number;
		color: number;
	};

	/** 指针与星点之间的一条连线（带生长 / 收回动画） */
	type Link = {
		star: number; // 星点在 stars 里的下标
		progress: number; // 0 = 刚出现，1 = 完全展开
		fading: boolean; // 正在收回
	};

	(function setupCursorAmbience() {
		// 幂等：Swup 切页会重跑模块脚本，这里只初始化一次
		if (window.__cursorAmbienceReady) return;
		window.__cursorAmbienceReady = true;

		const cfg = interactiveEffectsConfig;
		const reduceMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
		const finePointerQuery = window.matchMedia("(hover: hover) and (pointer: fine)");
		const desktopQuery = window.matchMedia("(min-width: 768px)");

		const canvas = document.getElementById(
			"starfield-canvas",
		) as HTMLCanvasElement | null;
		const glowEl = document.getElementById("cursor-glow");
		let ctx: CanvasRenderingContext2D | null = null;

		// ── 星点状态 ────────────────────────────────────────────
		// stars = 会有连线的「节点」；bgStars = 铺满背景的小星点（不连线）
		const stars: Star[] = [];
		const bgStars: BgStar[] = [];

		// ── 星域（世界坐标） ────────────────────────────────────
		// 星点铺在「横幅下方 → 页面底部」这块区域里，绘制时按滚动量平移：
		// 滚动时星点跟着页面走，而且永远不会跑到横幅背后去。
		let worldTop = 0; // 星域起点在文档里的 Y（横幅底部）
		let worldHeight = 0; // 星域高度
		let scrollOffset = 0; // 当前滚动量（相对星域起点）

		const measureWorld = () => {
			const wallpaper = document.getElementById("wallpaper-wrapper");
			const rect = wallpaper?.getBoundingClientRect();
			worldTop = rect ? Math.max(0, rect.bottom + window.scrollY) : 0;
			const docHeight = Math.max(
				document.documentElement.scrollHeight,
				window.innerHeight,
			);
			worldHeight = Math.max(window.innerHeight, docHeight - worldTop);
		};
		let viewW = 0;
		let viewH = 0;
		// 星空调色板：由主题主色的 oklch 派生出的一组星色（暗色下才用）
		let starColors: string[] = ["rgb(180, 240, 255)"];
		let canvasDirty = false;
		// 用户在设置面板里的开关（localStorage 覆盖配置默认值）
		let userEnabled = readUserEnabled();
		// 设置面板里的另外两个开关：指针光晕、指针连线（默认读配置）
		let glowUserEnabled =
			localStorage.getItem("cursorGlowEnabled") === null
				? cfg.cursorGlow.enable !== false
				: localStorage.getItem("cursorGlowEnabled") === "true";
		let linksUserEnabled =
			localStorage.getItem("pointerLinksEnabled") === null
				? cfg.starfield.pointerLinks !== false
				: localStorage.getItem("pointerLinksEnabled") === "true";

		function readUserEnabled(): boolean {
			const enable = cfg.starfield.enable;
			const fallback =
				typeof enable === "boolean" ? enable : (enable.desktop ?? false);
			try {
				const stored = localStorage.getItem("starfieldEnabled");
				return stored === null ? fallback : stored === "true";
			} catch {
				return fallback;
			}
		}

		// ── 指针 / 光晕状态 ─────────────────────────────────────
		const pointer = { x: 0, y: 0, seen: false, inside: false };
		let rafId: number | null = null;
		let resizeRafId: number | null = null;
		let colorSyncAt = 0;

		// ── 连线状态 ────────────────────────────────────────────
		// 最多 maxLinks 条；每条自己记录生长进度，指针换目标时旧线收回、新线长出
		const links: Link[] = [];
		const LINK_MS = 280; // 一条线从 0 长到 1（或收回）的时长
		let lastFrameAt = 0;

		// ── 发光贴图 ────────────────────────────────────────────
		// 每颗星都是一团柔光：逐帧 createRadialGradient 太贵，
		// 预渲染「颜色 × 暖/冷」几张精灵图，绘制时按星点大小缩放 drawImage
		const GLOW_TEX_R = 24; // 贴图半径（px）
		let glowSprites: HTMLCanvasElement[] = [];
		let warmSprite: HTMLCanvasElement | null = null;

		const isDark = () =>
			document.documentElement.classList.contains("dark");

		const starfieldOn = () => {
			if (!userEnabled) return false;
			const enable = cfg.starfield.enable;
			if (enable === true) return true;
			if (enable === false) return false;
			return desktopQuery.matches ? enable.desktop : enable.mobile;
		};

		/** 需要逐帧绘制星点 */
		const starsAnimating = () =>
			!!ctx &&
			starfieldOn() &&
			isDark() &&
			!document.hidden &&
			!reduceMotionQuery.matches;

		/** 需要逐帧移动光晕 */
		const glowActive = () =>
			!!glowEl &&
			cfg.cursorGlow.enable &&
			glowUserEnabled &&
			finePointerQuery.matches &&
			!reduceMotionQuery.matches;

		/**
		 * 生成星空调色板。
		 * 从 --primary 的 oklch 里取出亮度/彩度/色相，再按若干偏移派生出一组星色：
		 * 亮度都在 0.72 以上（星光要亮），色相绕主色散开（青→蓝→紫→粉，外加少量近白），
		 * 这样铺满屏的细小星点才有「彩色星空」而不是一片单色灰点。
		 * 用 1×1 canvas 让浏览器自己解析 CSS 颜色，不在 JS 里复刻色彩空间换算。
		 */
		const resolveStarPalette = () => {
			const probe = document.createElement("canvas");
			probe.width = 1;
			probe.height = 1;
			const pctx = probe.getContext("2d", { willReadFrequently: true });
			if (!pctx) return;

			const raw = getComputedStyle(document.documentElement)
				.getPropertyValue("--primary")
				.trim();
			// --primary 形如 oklch(0.78 0.115 202)
			const match = raw.match(
				/oklch\(\s*([\d.]+)\s+([\d.]+)\s+([\d.]+)\s*\)/i,
			);
			const base = match
				? { l: Number(match[1]), c: Number(match[2]), h: Number(match[3]) }
				: { l: 0.78, c: 0.11, h: 202 };

			// [亮度偏移, 彩度比例, 色相偏移]
			const specs: Array<[number, number, number]> = [
				[0.12, 0.55, -58],
				[0.16, 0.45, -30],
				[0.06, 1.0, 0],
				[0.14, 0.7, 26],
				[0.10, 0.85, 52],
				[0.16, 0.6, 84],
				[0.2, 0.15, -12],
				[0.18, 0.3, 18],
			];

			const colors: string[] = [];
			for (const [dl, cScale, dh] of specs) {
				const l = Math.min(0.98, base.l + dl);
				const c = Math.max(0.01, base.c * cScale);
				const h = (base.h + dh + 360) % 360;
				pctx.clearRect(0, 0, 1, 1);
				pctx.fillStyle = `oklch(${l.toFixed(3)} ${c.toFixed(3)} ${h.toFixed(1)})`;
				pctx.fillRect(0, 0, 1, 1);
				const d = pctx.getImageData(0, 0, 1, 1).data;
				// 解析失败拿到纯黑就跳过，避免黑色星点
				if (!d[3] || (d[0] + d[1] + d[2] === 0)) continue;
				colors.push(`rgb(${d[0]}, ${d[1]}, ${d[2]})`);
			}

			if (colors.length > 0) starColors = colors;
			buildGlowSprites();
		};

		const withAlpha = (color: string, a: number) => {
			const m = /rgba?\(([^)]+)\)/.exec(color);
			if (!m) return color;
			const parts = m[1].split(",").map((v) => v.trim());
			return `rgba(${parts[0]}, ${parts[1]}, ${parts[2]}, ${a})`;
		};

		/** 预渲染发光精灵：中心实心、向外渐隐到透明 */
		const makeGlowSprite = (color: string) => {
			const size = GLOW_TEX_R * 2;
			const el = document.createElement("canvas");
			el.width = size;
			el.height = size;
			const g = el.getContext("2d");
			if (!g) return el;
			const grad = g.createRadialGradient(
				GLOW_TEX_R,
				GLOW_TEX_R,
				0,
				GLOW_TEX_R,
				GLOW_TEX_R,
				GLOW_TEX_R,
			);
			grad.addColorStop(0, withAlpha(color, 1));
			grad.addColorStop(0.18, withAlpha(color, 0.85));
			grad.addColorStop(0.42, withAlpha(color, 0.28));
			grad.addColorStop(1, withAlpha(color, 0));
			g.fillStyle = grad;
			g.beginPath();
			g.arc(GLOW_TEX_R, GLOW_TEX_R, GLOW_TEX_R, 0, Math.PI * 2);
			g.fill();
			return el;
		};

		const buildGlowSprites = () => {
			glowSprites = starColors.map((color) => makeGlowSprite(color));
			// 暖色星：琥珀偏珊瑚，整片星空里 5% 左右，像参考图里那颗橘点
			warmSprite = makeGlowSprite("rgb(255, 186, 128)");
		};

		const buildStars = () => {
			stars.length = 0;
			bgStars.length = 0;
			// 星点下标会变，旧连线全部作废
			links.length = 0;
			if (!viewW || !viewH) return;
			const worldW = viewW;
			const worldArea = worldW * worldHeight;
			// 数量按整块星域算，但每屏看到的密度保持在原来的水平
			const count = Math.max(
				24,
				Math.round(worldArea / cfg.starfield.density),
			);
			const paletteSize = Math.max(1, starColors.length);
			for (let i = 0; i < count; i++) {
				const angle = Math.random() * Math.PI * 2;
				const speed = cfg.starfield.drift * (0.4 + Math.random() * 0.6);
				// 亮度分布：多数是中等亮度的节点，少量暗的做底噪
				const bright = Math.random();
				const alpha =
					bright > 0.9
						? 0.9 + Math.random() * 0.1
						: bright > 0.6
							? 0.6 + Math.random() * 0.25
							: 0.3 + Math.random() * 0.25;
				// 三档：背景微尘（不参与连线，只做底噪）/ 普通节点 / 大节点
				const roll = Math.random();
				const tiny = roll < 0.38;
				const big = roll > 0.78;
				stars.push({
					x: Math.random() * worldW,
					y: Math.random() * worldHeight,
					vx: Math.cos(angle) * speed,
					vy: Math.sin(angle) * speed,
					r: tiny
						? 0.35 + Math.random() * 0.45
						: big
							? 2.1 + Math.random() * 1.6
							: 1.1 + Math.random() * 1.1,
					alpha: tiny ? 0.35 + Math.random() * 0.3 : alpha,
					phase: Math.random() * Math.PI * 2,
					twinkle: 0.3 + Math.random() * 1.2,
					color: Math.floor(Math.random() * paletteSize),
					glow: tiny
						? 1.4 + Math.random() * 0.8
						: big
							? 4.6 + Math.random() * 2.6
							: 2.6 + Math.random() * 1.4,
					warm: !tiny && Math.random() < 0.08,
				});
			}

			// 背景繁星：数量按面积算（~3200px² 一颗），只做闪烁与漂移，不参与连线
			const bgCount = Math.max(
				80,
				Math.round(worldArea / cfg.starfield.bgDensity),
			);
			for (let i = 0; i < bgCount; i++) {
				const angle = Math.random() * Math.PI * 2;
				const speed = cfg.starfield.drift * (0.4 + Math.random() * 0.6);
				bgStars.push({
					x: Math.random() * worldW,
					y: Math.random() * worldHeight,
					vx: Math.cos(angle) * speed,
					vy: Math.sin(angle) * speed,
					// 小：0.35–1.0px，靠数量堆出满天星
					r: 0.35 + Math.random() * 0.65,
					alpha: 0.16 + Math.random() * 0.44,
					phase: Math.random() * Math.PI * 2,
					twinkle: 0.3 + Math.random() * 1.8,
					color: Math.floor(Math.random() * paletteSize),
				});
			}
		};

		const sizeCanvas = () => {
			viewW = window.innerWidth;
			viewH = window.innerHeight;
			if (!canvas) return;
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			canvas.width = Math.round(viewW * dpr);
			canvas.height = Math.round(viewH * dpr);
			ctx = canvas.getContext("2d");
			if (ctx) ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			measureWorld();
			buildStars();
		};

		const clearCanvas = () => {
			if (!ctx) return;
			ctx.clearRect(0, 0, viewW, viewH);
			canvasDirty = false;
		};

		/** 静态星点：减弱动态时保留画面，但不逐帧重绘 */
		const drawStaticStars = () => {
			if (!ctx || !starfieldOn() || !isDark()) {
				clearCanvas();
				return;
			}
			scrollOffset = window.scrollY - worldTop;
			ctx.clearRect(0, 0, viewW, viewH);
			// 静态模式：背景繁星直接按各自的 alpha 画一遍（不闪烁）
			const paletteSize = Math.max(1, starColors.length);
			for (let c = 0; c < paletteSize; c++) {
				const list = bgStars.filter((s) => s.color === c);
				if (!list.length) continue;
				ctx.fillStyle = starColors[c];
				ctx.globalAlpha = 0.5;
				ctx.beginPath();
				for (const s of list) {
					const sy = s.y - scrollOffset;
					if (sy < -6 || sy > viewH + 6) continue;
					ctx.moveTo(s.x + s.r, sy);
					ctx.arc(s.x, sy, s.r, 0, Math.PI * 2);
				}
				ctx.fill();
			}
			ctx.globalAlpha = 1;
			drawStarLinks(0.55);
			for (const s of stars) {
				const sy = s.y - scrollOffset;
				if (sy < -40 || sy > viewH + 40) continue;
				const sprite = s.warm ? warmSprite : glowSprites[s.color];
				if (sprite) {
					const R = s.r * s.glow;
					ctx.globalAlpha = s.alpha * 0.75;
					ctx.drawImage(sprite, s.x - R, sy - R, R * 2, R * 2);
				}
			}
			ctx.globalAlpha = 1;
			canvasDirty = true;
		};

		/**
		 * 背景繁星：按「颜色 × 明暗」分桶批量画（几种颜色 × 两个明暗档 = 十几次 fill），
		 * 几百颗也只是十来次填充，比逐颗设 fillStyle 便宜得多。
		 */
		const bgBuckets: BgStar[][][] = [];
		const drawBgStars = (time: number) => {
			if (!ctx || bgStars.length === 0) return;
			const paletteSize = Math.max(1, starColors.length);
			while (bgBuckets.length < paletteSize) bgBuckets.push([[], []]);
			for (const b of bgBuckets) {
				b[0].length = 0;
				b[1].length = 0;
			}

			for (const s of bgStars) {
				s.x += s.vx;
				s.y += s.vy;
				if (s.x < -3) s.x = viewW + 3;
				else if (s.x > viewW + 3) s.x = -3;
				if (s.y < -3) s.y = worldHeight + 3;
				else if (s.y > worldHeight + 3) s.y = -3;

				// 视口外的直接跳过（星域可能比屏幕长很多）
				const sy = s.y - scrollOffset;
				if (sy < -6 || sy > viewH + 6) continue;

				const pulse = Math.sin(time * 0.0012 * s.twinkle + s.phase);
				const bucket = (bgBuckets[s.color] ?? bgBuckets[0])[pulse > 0 ? 1 : 0];
				bucket.push(s);
			}

			for (let c = 0; c < paletteSize; c++) {
				ctx.fillStyle = starColors[c];
				for (let bucket = 0; bucket < 2; bucket++) {
					const list = bgBuckets[c][bucket];
					if (!list.length) continue;
					ctx.globalAlpha = bucket === 1 ? 0.85 : 0.38;
					ctx.beginPath();
					for (const s of list) {
						const sy = s.y - scrollOffset;
						ctx.moveTo(s.x + s.r, sy);
						ctx.arc(s.x, sy, s.r, 0, Math.PI * 2);
					}
					ctx.fill();
				}
			}
			ctx.globalAlpha = 1;
		};

		/**
		 * 星点之间的连线（星座）：要「少而清楚」。
		 * 做法：每个节点只连最近的邻居（每点最多 2 条），去重后总量封顶 ——
		 * 于是得到一条条短链/小三角形，像菜单的层级线，而不是一张密网。
		 * 只在视口内的节点之间连；世界坐标算距离，绘制时按滚动量平移。
		 */
		const visibleNodes: Star[] = [];
		const drawStarLinks = (alphaScale: number) => {
			if (!ctx) return;
			visibleNodes.length = 0;
			for (const s of stars) {
				if (s.r < 1) continue;
				const sy = s.y - scrollOffset;
				if (sy < -20 || sy > viewH + 20) continue;
				visibleNodes.push(s);
			}
			if (visibleNodes.length < 2) return;

			const maxD = cfg.starfield.starLinkDistance;
			const maxD2 = maxD * maxD;
			const degree = new Map<Star, number>();
			const seen = new Set<string>();
			const pairs: Array<[Star, Star]> = [];

			for (const A of visibleNodes) {
				if (pairs.length >= cfg.starfield.starLinkMax) break;
				if ((degree.get(A) ?? 0) >= 2) continue;
				let best: Star | null = null;
				let bestD2 = maxD2;
				for (const B of visibleNodes) {
					if (B === A || (degree.get(B) ?? 0) >= 2) continue;
					const dx = B.x - A.x;
					const dy = B.y - A.y;
					const d2 = dx * dx + dy * dy;
					if (d2 < bestD2) {
						bestD2 = d2;
						best = B;
					}
				}
				if (!best) continue;
				const key =
					visibleNodes.indexOf(A) < visibleNodes.indexOf(best)
						? `${stars.indexOf(A)}-${stars.indexOf(best)}`
						: `${stars.indexOf(best)}-${stars.indexOf(A)}`;
				if (seen.has(key)) continue;
				seen.add(key);
				degree.set(A, (degree.get(A) ?? 0) + 1);
				degree.set(best, (degree.get(best) ?? 0) + 1);
				pairs.push([A, best]);
			}
			if (pairs.length === 0) return;

			ctx.strokeStyle = "rgba(186, 206, 246, 0.62)";
			ctx.lineWidth = 1;
			ctx.globalAlpha = alphaScale;
			ctx.beginPath();
			for (const [A, B] of pairs) {
				ctx.moveTo(A.x, A.y - scrollOffset);
				ctx.lineTo(B.x, B.y - scrollOffset);
			}
			ctx.stroke();
			ctx.globalAlpha = 1;
		};

		/**
		 * 逐帧绘制：
		 * 1) 星点按「颜色 × 明暗」分组，每组一次 path + 一次 fill（紫/蓝/粉/白各一组，共十余次填充，
		 *    比逐颗设 fillStyle 便宜得多，又保住了每颗自身的闪烁节奏）
		 * 2) 「指针 → 星点」的连线：半径内所有星点都连，按距离分三档做纵深（见 drawLinks）
		 */
		const drawStars = (time: number, dt: number) => {
			if (!ctx) return;
			ctx.clearRect(0, 0, viewW, viewH);

			// 世界坐标 → 视口：scrollOffset = scrollY - worldTop。
			// 页面在顶部时它是负值（星域从横幅底下开始），滚动后变大，星点跟着页面上移。
			scrollOffset = window.scrollY - worldTop;

			// 1) 先推进漂移（世界坐标内环绕）
			for (const s of stars) {
				s.x += s.vx;
				s.y += s.vy;
				if (s.x < -6) s.x = viewW + 6;
				else if (s.x > viewW + 6) s.x = -6;
				if (s.y < -6) s.y = worldHeight + 6;
				else if (s.y > worldHeight + 6) s.y = -6;
			}

			// 2) 背景繁星（最底层，铺满画面的底噪）
			drawBgStars(time);

			// 3) 星点之间的星座连线（稀疏短链，压在星点下面）
			drawStarLinks(0.75 + 0.25 * Math.sin(time * 0.0006));

			// 4) 星点本体：柔光贴图 + 实心亮核（只画视口内的）
			for (const s of stars) {
				const sy = s.y - scrollOffset;
				if (sy < -40 || sy > viewH + 40) continue;
				const sprite = s.warm ? warmSprite : glowSprites[s.color];
				if (!sprite) continue;
				const R = s.r * s.glow;
				const twinkle = 0.82 + 0.18 * Math.sin(time * 0.0011 * s.twinkle + s.phase);
				const a = Math.min(1, s.alpha * twinkle);
				ctx.globalAlpha = a * 0.85;
				ctx.drawImage(sprite, s.x - R, sy - R, R * 2, R * 2);
				if (s.r >= 1) {
					ctx.globalAlpha = a;
					ctx.fillStyle = s.warm ? "rgb(255, 226, 196)" : "rgb(236, 243, 255)";
					ctx.beginPath();
					ctx.arc(s.x, sy, s.r * 0.62, 0, Math.PI * 2);
					ctx.fill();
				}
			}
			ctx.globalAlpha = 1;

			// 5) 指针连线：最多 maxLinks 条，带生长 / 收回动画（见 drawLinks）
			updateLinks(dt);
			drawLinks();
			canvasDirty = true;
		};

		/**
		 * 维护「指针 → 星点」的连线集合（10-26 那版的效果）：
		 * - 任意时刻最多 cfg.starfield.maxLinks 条（3 条）
		 * - 新连线从 0 长到 1，被换下的线缩回 0 再移除 —— 有动画过渡，不是瞬间连接
		 * - 已有连线带迟滞保留（半径放宽 1.7 倍），指针微动不会来回跳线
		 * - 线的起点永远是当前指针坐标，所以「生长」不会带来跟手延迟
		 */
		const updateLinks = (dt: number) => {
			// 设置里关掉指针连线：清空并跳过
			if (!linksUserEnabled) {
				if (links.length) links.length = 0;
				return;
			}
			const maxLinks = Math.max(1, Math.trunc(cfg.starfield.maxLinks ?? 3));
			const maxD = cfg.starfield.pointerDistance;
			const maxD2 = maxD * maxD;
			const hasPointer = pointer.seen && pointer.inside;

			// 指针在视口里、星点在世界里：把指针换算到世界坐标再比距离
			const pointerWY = pointer.y + scrollOffset;
			if (hasPointer) {
				// 1) 收集范围内的星点，按距离升序
				const candidates: Array<{ i: number; d2: number }> = [];
				for (let k = 0; k < stars.length; k++) {
					const star = stars[k];
					const dx = star.x - pointer.x;
					const dy = star.y - pointerWY;
					const d2 = dx * dx + dy * dy;
					if (d2 <= maxD2) candidates.push({ i: k, d2 });
				}
				candidates.sort((a, b) => a.d2 - b.d2);

				// 2) 旧连线只要还在 1.3 倍半径内就保留（迟滞）
				const target = new Set<number>();
				for (const l of links) {
					const star = stars[l.star];
					if (!star) continue;
					const dx = star.x - pointer.x;
					const dy = star.y - pointerWY;
					if (dx * dx + dy * dy <= maxD2 * 1.7) target.add(l.star);
				}

				// 3) 用最近的星点补满
				for (const c of candidates) {
					if (target.size >= maxLinks) break;
					target.add(c.i);
				}
				if (target.size > maxLinks) {
					const kept = Array.from(target).slice(0, maxLinks);
					target.clear();
					for (const k of kept) target.add(k);
				}

				// 4) 同步 fading 标记，新目标补进 links
				for (const l of links) l.fading = !target.has(l.star);
				for (const k of target) {
					if (!links.some((l) => l.star === k)) {
						links.push({ star: k, progress: 0, fading: false });
					}
				}
			} else {
				// 指针离开窗口：全部收回
				for (const l of links) l.fading = true;
			}

			// 5) 推进进度
			const step = dt / LINK_MS;
			for (let k = links.length - 1; k >= 0; k--) {
				const l = links[k];
				l.progress += l.fading ? -step : step;
				if (l.progress > 1) l.progress = 1;
				if (l.progress <= 0) links.splice(k, 1);
			}
		};

		const drawLinks = () => {
			if (!ctx || !links.length) return;
			const color = starColors[0] ?? "rgb(190, 215, 255)";
			ctx.strokeStyle = withAlpha(color, 1);
			ctx.lineWidth = 1;
			ctx.fillStyle = color;

			for (const l of links) {
				const star = stars[l.star];
				if (!star) continue;
				// easeOutCubic：起步快、末尾收得柔
				const k = 1 - (1 - l.progress) * (1 - l.progress) * (1 - l.progress);
				const starScreenY = star.y - scrollOffset;
				const ex = pointer.x + (star.x - pointer.x) * k;
				const ey = pointer.y + (starScreenY - pointer.y) * k;

				ctx.globalAlpha = 0.62 * k;
				ctx.beginPath();
				ctx.moveTo(pointer.x, pointer.y);
				ctx.lineTo(ex, ey);
				ctx.stroke();

				// 线头的小亮点：让线「够到」星点，而不是硬连过去
				ctx.globalAlpha = 0.85 * k;
				ctx.beginPath();
				ctx.arc(ex, ey, 1.1, 0, Math.PI * 2);
				ctx.fill();
			}
			ctx.globalAlpha = 1;
		};

		/**
		 * 光晕直接写位置，不做插值：
		 * 之前用 lerp 追指针，手感上就是「慢半拍」；改成在 pointermove 里立即落到指针坐标，
		 * 光晕与光标同步移动（浏览器自己会合并高频事件，不会因此更费）。
		 */
		const syncGlowToPointer = () => {
			if (!glowEl) return;
			glowEl.style.transform = `translate3d(${pointer.x}px, ${pointer.y}px, 0)`;
		};

		const frame = (now: number) => {
			rafId = null;

			// dt 只用于连线生长 / 收回；首帧与切回前台时钳制上限，避免大跳变
			const dt = lastFrameAt ? Math.min(48, now - lastFrameAt) : 16;
			lastFrameAt = now;

			const starsActive = starsAnimating();
			if (starsActive) drawStars(now, dt);
			else if (canvasDirty) clearCanvas();

			// 还有连线在生长 / 收回时也要继续跑，否则动画会停半路
			const linksAnimating = links.some((l) => l.progress > 0 && l.progress < 1);

			if (starsActive || linksAnimating) {
				rafId = requestAnimationFrame(frame);
			}
		};

		const schedule = () => {
			if (rafId !== null) return;
			if (reduceMotionQuery.matches) {
				drawStaticStars();
				return;
			}
			const linksAnimating = links.some((l) => l.progress > 0 && l.progress < 1);
			if (!starsAnimating() && !linksAnimating) {
				if (canvasDirty) clearCanvas();
				return;
			}
			rafId = requestAnimationFrame(frame);
		};

		// ── 初次装载 ────────────────────────────────────────────
		if (canvas) {
			sizeCanvas();
			resolveStarPalette();
			// 调色板依赖 --primary，必须先解析再建星
			buildStars();
		}

		// ── 指针光晕 / 指针连线开关（设置面板） ──────────────────
		window.addEventListener("cursorGlowToggle", (event: Event) => {
			const detail = (event as CustomEvent<{ enabled: boolean }>).detail;
			if (!detail) return;
			glowUserEnabled = detail.enabled;
			if (glowUserEnabled) {
				glowEl?.setAttribute("data-visible", "true");
			} else {
				glowEl?.removeAttribute("data-visible");
			}
		});
		window.addEventListener("pointerLinksToggle", (event: Event) => {
			const detail = (event as CustomEvent<{ enabled: boolean }>).detail;
			if (!detail) return;
			linksUserEnabled = detail.enabled;
			if (!linksUserEnabled) links.length = 0;
		});

		// ── 设置面板开关（实时生效，不需要刷新） ─────────────────
		window.addEventListener("starfieldToggle", (event: Event) => {
			const detail = (event as CustomEvent<{ enabled: boolean }>).detail;
			if (!detail) return;
			userEnabled = detail.enabled;
			if (!userEnabled) {
				if (rafId !== null) {
					cancelAnimationFrame(rafId);
					rafId = null;
				}
				clearCanvas();
				return;
			}
			buildStars();
			drawStaticStars();
			schedule();
		});

		// ── 指针 ────────────────────────────────────────────────
		const onPointerMove = (event: PointerEvent) => {
			pointer.x = event.clientX;
			pointer.y = event.clientY;
			pointer.inside = true;
			if (!pointer.seen) {
				pointer.seen = true;
				glowEl?.setAttribute("data-visible", "true");
			}
			// 光晕逐事件直接跟随，不走 rAF 插值（否则永远慢半拍）
			syncGlowToPointer();
			schedule();
		};

		const onPointerLeave = () => {
			pointer.inside = false;
			glowEl?.removeAttribute("data-visible");
		};

		if (glowActive()) {
			window.addEventListener("pointermove", onPointerMove, {
				passive: true,
			});
			document.addEventListener("pointerleave", onPointerLeave);
			document.addEventListener("pointerenter", () => {
				pointer.inside = true;
				glowEl?.setAttribute("data-visible", "true");
			});
		} else if (canvas) {
			// 没有光晕时，断点/设备条件变化后仍需要指针位置来连线
			window.addEventListener("pointermove", onPointerMove, {
				passive: true,
			});
		}

		// 移动端滚动时会触发 pointermove；星点只在可见时才连，开销可忽略
		document.addEventListener("visibilitychange", () => {
			if (document.hidden) {
				if (rafId !== null) {
					cancelAnimationFrame(rafId);
					rafId = null;
				}
				clearCanvas();
				return;
			}
			schedule();
		});

		// ── 主题 / 色相变化 ─────────────────────────────────────
		new MutationObserver(() => {
			const now = performance.now();
			if (!isDark()) clearCanvas();
			// 切主题/换色相会连带 --primary 变化：重算调色板并重新分配星色。
			// 限流，避免连续写入触发大量 1×1 canvas 解析
			if (now - colorSyncAt > 240) {
				colorSyncAt = now;
				resolveStarPalette();
				buildStars();
			}
			schedule();
		}).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class", "style"],
		});

		// ── 尺寸 ────────────────────────────────────────────────
		window.addEventListener("resize", () => {
			if (resizeRafId !== null) return;
			resizeRafId = requestAnimationFrame(() => {
				resizeRafId = null;
				sizeCanvas();
				schedule();
			});
		});

		// 断点/偏好变化（例如拖动窗口跨 768px、切换「减弱动态」）
		for (const query of [desktopQuery, reduceMotionQuery]) {
			query.addEventListener("change", () => {
				resizeRafId = null;
				sizeCanvas();
				schedule();
			});
		}

		// 切页后文档高度变了：重新量星域、重建星点（星点铺在「横幅下方 → 页面底部」）
		const refreshWorld = () => {
			measureWorld();
			buildStars();
			drawStaticStars();
			schedule();
		};
		document.addEventListener("astro:page-load", refreshWorld);
		document.addEventListener("swup:contentReplaced", refreshWorld);
		// 图片/字体加载完页面才最终定高，晚一点再量一次
		window.addEventListener("load", refreshWorld);
		if ("ResizeObserver" in window) {
			let lastHeight = document.documentElement.scrollHeight;
			new ResizeObserver(() => {
				const height = document.documentElement.scrollHeight;
				if (Math.abs(height - lastHeight) < 64) return;
				lastHeight = height;
				refreshWorld();
			}).observe(document.body);
		}

		// 首帧：静态星点先行，之后由 rAF 接管（避免暗色下首屏空白一帧）
		drawStaticStars();
		schedule();
	})();
</script>
