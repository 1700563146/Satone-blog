---
// IntroSplash —— 首次进入博客的开屏动画：钢笔式线条一格格勾勒出「博客页面」的轮廓。
//
// 设计要点（参考 satone intro spec v1.1，不照搬）：
//   · 抽象几何构图：窗口框 + 顶栏三点 + 横幅地平线/月亮 + 标题短线 + 三张卡片 + 头像圆
//   · 手绘感：路径带轻微抖动、圆头圆角、线宽用 non-scaling-stroke 保持 1.4px
//   · 节奏：主框 → 顶栏 → 横幅 → 标题 → 卡片 → 细节，逐笔错开（共 ~1.35s），
//     停留 ~260ms 后整层淡出 0.5s
//   · 只在首次访问播放：是否播放由 <head> 里的内联脚本先判定（避免闪一下），
//     这里只负责播放 / 跳过 / 收尾
//   · 尊重 prefers-reduced-motion；存储不可用 / 脚本出错都会直接放行页面
---

<div id="intro-splash" role="presentation" aria-hidden="true">
	<svg
		class="intro-svg"
		viewBox="0 0 1000 760"
		preserveAspectRatio="xMidYMid meet"
		fill="none"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<!-- 页面外框（窗口） -->
		<path
			class="intro-line intro-line-main"
			pathLength="100"
			style="--intro-delay: 40ms; --intro-dur: 640ms"
			d="M152 100 C252 94 424 91 564 92 C694 93 806 96 850 102 C882 107 890 126 890 154 C891 320 891 520 889 650 C888 692 874 701 840 703 C700 707 420 707 214 703 C176 702 152 690 151 650 C148 500 148 260 150 176 C151 148 150 116 152 100 Z"
		/>
		<!-- 顶栏分隔线 -->
		<path
			class="intro-line intro-line-muted"
			pathLength="100"
			style="--intro-delay: 120ms; --intro-dur: 320ms"
			d="M150 150 C330 148 640 151 890 149"
		/>
		<!-- 窗口三点 -->
		<circle class="intro-line intro-line-muted" pathLength="100" cx="182" cy="120" r="6" style="--intro-delay: 200ms; --intro-dur: 200ms" />
		<circle class="intro-line intro-line-muted" pathLength="100" cx="204" cy="120" r="6" style="--intro-delay: 240ms; --intro-dur: 200ms" />
		<circle class="intro-line intro-line-muted" pathLength="100" cx="226" cy="120" r="6" style="--intro-delay: 280ms; --intro-dur: 200ms" />

		<!-- 横幅：地平线 + 月亮 + 远山 -->
		<path
			class="intro-line intro-line-muted"
			pathLength="100"
			style="--intro-delay: 300ms; --intro-dur: 420ms"
			d="M152 372 C260 356 344 392 448 376 C548 360 610 396 700 380 C780 366 830 390 890 376"
		/>
		<circle class="intro-line" pathLength="100" cx="762" cy="248" r="46" style="--intro-delay: 360ms; --intro-dur: 340ms" />
		<path
			class="intro-line intro-line-muted"
			pathLength="100"
			style="--intro-delay: 430ms; --intro-dur: 360ms"
			d="M148 372 C214 330 268 300 320 372"
		/>
		<path
			class="intro-line intro-line-muted"
			pathLength="100"
			style="--intro-delay: 470ms; --intro-dur: 360ms"
			d="M436 376 C500 312 566 292 628 376"
		/>

		<!-- 标题：一长一短两笔（暗示站名） -->
		<path class="intro-line intro-line-strong" pathLength="100" style="--intro-delay: 420ms; --intro-dur: 300ms" d="M196 262 C288 259 356 262 424 260" />
		<path class="intro-line intro-line-muted" pathLength="100" style="--intro-delay: 470ms; --intro-dur: 240ms" d="M198 300 C258 298 300 301 338 299" />

		<!-- 卡片 A / B（左列） -->
		<path
			class="intro-line"
			pathLength="100"
			style="--intro-delay: 540ms; --intro-dur: 380ms"
			d="M176 404 C280 401 420 402 540 403 C562 404 566 414 566 430 C568 470 568 492 565 508 C563 520 552 524 532 524 C420 526 268 526 192 524 C176 523 170 515 170 500 C168 470 168 440 170 428 C171 412 160 407 176 404 Z"
		/>
		<path
			class="intro-line"
			pathLength="100"
			style="--intro-delay: 620ms; --intro-dur: 380ms"
			d="M176 586 C300 583 440 584 540 585 C562 586 566 596 566 612 C568 636 568 648 565 656 C563 666 552 668 532 668 C420 670 268 670 192 668 C176 667 170 661 170 648 C168 628 168 612 170 604 C171 592 160 589 176 586 Z"
		/>
		<!-- 卡片 C（右列） -->
		<path
			class="intro-line"
			pathLength="100"
			style="--intro-delay: 700ms; --intro-dur: 400ms"
			d="M606 404 C690 401 790 402 848 403 C866 404 870 414 870 430 C872 520 872 610 869 658 C867 672 856 676 838 676 C770 678 676 678 622 676 C606 675 600 666 600 652 C598 520 598 450 600 428 C601 412 590 407 606 404 Z"
		/>
		<!-- 头像圆 -->
		<circle class="intro-line" pathLength="100" cx="736" cy="508" r="40" style="--intro-delay: 780ms; --intro-dur: 320ms" />

		<!-- 卡片里的文字线 -->
		<path class="intro-line intro-line-muted" pathLength="100" style="--intro-delay: 800ms; --intro-dur: 240ms" d="M202 444 C300 442 400 444 486 443" />
		<path class="intro-line intro-line-muted" pathLength="100" style="--intro-delay: 840ms; --intro-dur: 220ms" d="M202 474 C276 472 330 474 392 473" />
		<path class="intro-line intro-line-muted" pathLength="100" style="--intro-delay: 880ms; --intro-dur: 240ms" d="M202 622 C310 620 420 622 496 621" />

		<!-- 收笔细节：十字 + 星点 + 一道斜线 -->
		<path class="intro-line intro-line-accent" pathLength="100" style="--intro-delay: 960ms; --intro-dur: 220ms" d="M846 196 L874 224" />
		<path class="intro-line intro-line-accent" pathLength="100" style="--intro-delay: 1000ms; --intro-dur: 220ms" d="M874 196 L846 224" />
		<path class="intro-line intro-line-accent" pathLength="100" style="--intro-delay: 1040ms; --intro-dur: 200ms" d="M150 700 L166 716" />
		<path class="intro-line intro-line-accent" pathLength="100" style="--intro-delay: 1070ms; --intro-dur: 200ms" d="M166 700 L150 716" />
		<path
			class="intro-line intro-line-accent"
			pathLength="100"
			style="--intro-delay: 1100ms; --intro-dur: 320ms"
			d="M640 700 C720 706 800 704 900 708"
		/>
	</svg>

	<button type="button" class="intro-skip" id="intro-skip" aria-label="跳过开屏动画">跳过</button>
</div>

<style>
	/* 只有当 <head> 的内联脚本判定「首次访问且未开启减弱动态」时才会显示 */
	#intro-splash {
		position: fixed;
		inset: 0;
		z-index: 10050;
		display: none;
		place-items: center;
		background: var(--intro-bg, #0b1020);
		opacity: 1;
		transition: opacity 520ms ease;
	}

	html.intro-pending #intro-splash {
		display: grid;
	}

	/* 收尾：整层淡出，结束后由脚本移除节点 */
	#intro-splash.intro-out {
		opacity: 0;
		pointer-events: none;
	}

	html.intro-pending,
	html.intro-pending body {
		overflow: hidden;
	}

	.intro-svg {
		width: min(92vw, 112vh);
		max-width: 1080px;
		height: auto;
		overflow: visible;
		paint-order: stroke;
	}

	/* 竖屏：铺满宽度、整体略微上移（视觉中心略高于中线），构图不会被裁切 */
	@media (max-aspect-ratio: 1 / 1) {
		.intro-svg {
			width: 100vw;
			transform: translateY(-4vh) scale(1.02);
		}
	}

	/* 线宽：用 non-scaling-stroke，缩放时保持视觉粗细一致 */
	.intro-line {
		stroke: var(--intro-line, rgba(206, 220, 250, 0.85));
		stroke-width: 1.4;
		vector-effect: non-scaling-stroke;
		stroke-dasharray: 100;
		stroke-dashoffset: 100;
		animation: intro-draw var(--intro-dur, 340ms) cubic-bezier(0.33, 0, 0.25, 1)
			var(--intro-delay, 0ms) forwards;
	}

	.intro-line-main {
		stroke: var(--intro-line-strong, rgba(232, 240, 255, 0.95));
		stroke-width: 1.7;
	}

	.intro-line-strong {
		stroke: var(--intro-line-strong, rgba(232, 240, 255, 0.95));
		stroke-width: 3.2;
	}

	.intro-line-muted {
		stroke: var(--intro-line-muted, rgba(196, 212, 245, 0.55));
		stroke-width: 1.2;
	}

	.intro-line-accent {
		stroke: var(--intro-accent, var(--primary, #7fd6e8));
		stroke-width: 1.6;
	}

	@keyframes intro-draw {
		to {
			stroke-dashoffset: 0;
		}
	}

	.intro-skip {
		position: absolute;
		right: clamp(1rem, 4vw, 2.5rem);
		bottom: clamp(1rem, 5vh, 2.5rem);
		min-width: 44px;
		min-height: 44px;
		padding: 0 1.1rem;
		border-radius: 999px;
		border: 1px solid var(--intro-line-muted, rgba(196, 212, 245, 0.5));
		background: color-mix(in oklch, var(--intro-bg, #0b1020) 70%, transparent);
		color: var(--intro-line, rgba(214, 226, 250, 0.9));
		font-size: 0.78rem;
		letter-spacing: 0.12em;
		cursor: pointer;
		backdrop-filter: blur(6px);
		transition:
			background-color 200ms ease,
			color 200ms ease,
			border-color 200ms ease;
	}

	.intro-skip:hover {
		border-color: var(--intro-accent, var(--primary, #7fd6e8));
		color: var(--intro-line-strong, #fff);
	}

	.intro-skip:focus-visible {
		outline: 2px solid var(--intro-accent, var(--primary, #7fd6e8));
		outline-offset: 3px;
	}

	/* 暗 / 亮：复用站点已有的 html.dark 状态，不另建主题系统 */
	html.dark {
		--intro-bg: #0a0f1c;
		--intro-line: rgba(208, 222, 250, 0.8);
		--intro-line-strong: rgba(236, 244, 255, 0.95);
		--intro-line-muted: rgba(196, 212, 245, 0.5);
		--intro-accent: var(--primary, #7fd6e8);
	}

	html:not(.dark) {
		--intro-bg: #f4f6fb;
		--intro-line: rgba(36, 44, 66, 0.62);
		--intro-line-strong: rgba(20, 26, 44, 0.82);
		--intro-line-muted: rgba(40, 50, 76, 0.32);
		--intro-accent: color-mix(in oklch, var(--primary, #0aa) 78%, #10203a);
	}

	/* 减弱动态：不做逐笔绘制，最多一次极短淡入 */
	@media (prefers-reduced-motion: reduce) {
		.intro-line {
			animation: none;
			stroke-dashoffset: 0;
		}

		#intro-splash {
			transition: opacity 120ms linear;
		}
	}
</style>

<script>
	(function setupIntroSplash() {
		if (window.__introSplashReady) return;
		window.__introSplashReady = true;

		const STORAGE_KEY = "satone-blog:intro-seen:v1";
		const root = document.documentElement;
		const overlay = document.getElementById("intro-splash");
		const skipButton = document.getElementById("intro-skip");

		let seenBefore = true;
		try {
			seenBefore = window.localStorage.getItem(STORAGE_KEY) === "1";
		} catch {
			// 存储不可用：当作「已看过」，不播动画，保证博客正常可用
			seenBefore = true;
		}

		const isPending = root.classList.contains("intro-pending");

		// 不是首次访问 / 被内联脚本拦下：直接清掉覆盖层，不留残留节点
		if (!overlay || seenBefore || !isPending) {
			overlay?.remove();
			root.classList.remove("intro-pending");
			return;
		}

		const markSeen = () => {
			try {
				window.localStorage.setItem(STORAGE_KEY, "1");
			} catch {
				// 写入失败：本次文档内用内存标记兜底
				(window as unknown as { __introSeen?: boolean }).__introSeen = true;
			}
		};

		let finished = false;
		let outTimer = 0;
		let guardTimer = 0;

		const cleanup = () => {
			window.clearTimeout(outTimer);
			window.clearTimeout(guardTimer);
			document.removeEventListener("keydown", onKey);
			overlay.removeEventListener("click", onSkip);
			skipButton?.removeEventListener("click", onSkip);
			root.classList.remove("intro-pending");
			root.classList.add("intro-done");
		};

		const finish = () => {
			if (finished) return;
			finished = true;
			markSeen();
			overlay.classList.add("intro-out");
			outTimer = window.setTimeout(() => {
				overlay.remove();
				cleanup();
			}, 560);
		};

		function onKey(event: KeyboardEvent): void {
			if (event.key === "Escape" || event.key === "Enter" || event.key === " ") {
				finish();
			}
		}

		function onSkip(event: Event): void {
			event.preventDefault();
			event.stopPropagation();
			finish();
		}

		// 跳过：按钮、整层点击、Esc / 回车 / 空格
		skipButton?.addEventListener("click", onSkip);
		overlay.addEventListener("click", onSkip);
		document.addEventListener("keydown", onKey);

		// 兜底：即使动画事件丢失（后台标签、动画被浏览器暂停）也一定收场
		guardTimer = window.setTimeout(finish, 3200);

		// 正常节奏：最后一笔 ~1.42s 画完 → 停留片刻 → 淡出
		const lastDelay = 1100;
		const lastDur = 320;
		window.setTimeout(finish, lastDelay + lastDur + 320);
	})();
</script>
