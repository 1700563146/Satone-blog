---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
// 音乐页：黑胶唱片牌面 + 可切换的盘廊 + 曲目列表。
// 曲库由 `pnpm music:sync` 生成到 public/music/library.json，
// 页面运行时只 fetch 这一个静态文件（不碰第三方接口），几百首也不会撑大 HTML。
const LIBRARY_URL = "/music/library.json";
---

<MainGridLayout title="音乐" description="站内音乐播放与曲目列表">
	<div class="flex flex-col gap-4">
		<WidgetLayout id="music-disc-hero" name="正在播放">
			<div id="music-hero" class="music-hero" data-library={LIBRARY_URL}>
				<div class="disc-stage">
					<div class="disc-shadow" aria-hidden="true"></div>
					<div class="disc" id="music-disc" aria-hidden="true">
						<div class="disc-rotor">
							<div class="disc-grooves"></div>
							<div class="disc-shine"></div>
							<div class="disc-logo" id="music-disc-label">
								<img id="music-disc-cover" alt="" decoding="async" referrerpolicy="no-referrer" />
								<span id="music-disc-initial">♪</span>
							</div>
						</div>
						<div class="disc-spindle"></div>
					</div>
					<!-- 唱针：播放时落到唱片上，暂停时摆回外侧 -->
					<div class="tonearm" id="music-tonearm" aria-hidden="true">
						<span class="tonearm-base"></span>
						<span class="tonearm-arm">
							<span class="tonearm-head"></span>
						</span>
					</div>
				</div>

				<div class="music-info">
					<p class="music-eyebrow">
						<Icon name="material-symbols:album-rounded" class="text-[1rem]" />
						<span id="music-source">在线歌单（Meting · 构建期同步）</span>
						<span class="music-dot">·</span>
						<span id="music-count">曲库载入中…</span>
					</p>
					<h2 class="music-title" id="music-now-title">—</h2>
					<p class="music-artist" id="music-now-artist">—</p>

					<div class="music-progress">
						<button type="button" class="music-progress-track" id="music-progress" aria-label="播放进度">
							<span class="music-progress-fill" id="music-progress-fill"></span>
						</button>
						<div class="music-times">
							<span id="music-time-current">0:00</span>
							<span id="music-time-total">0:00</span>
						</div>
					</div>

					<div class="music-controls">
						<button type="button" class="music-btn" id="music-prev" aria-label="上一首">
							<Icon name="material-symbols:skip-previous-rounded" class="text-[1.35rem]" />
						</button>
						<button type="button" class="music-btn music-btn-primary" id="music-toggle" aria-label="播放">
							<Icon name="material-symbols:play-arrow-rounded" class="text-[1.7rem]" id="music-icon-play" />
							<Icon name="material-symbols:pause-rounded" class="text-[1.7rem] hidden" id="music-icon-pause" />
						</button>
						<button type="button" class="music-btn" id="music-next" aria-label="下一首">
							<Icon name="material-symbols:skip-next-rounded" class="text-[1.35rem]" />
						</button>
					</div>
					<p class="music-hint" id="music-hint">正在载入曲库…</p>
				</div>
			</div>

			<div class="disc-strip" id="music-strip" role="list" aria-label="曲目唱片"></div>
		</WidgetLayout>

		<WidgetLayout id="music-track-list" name="曲目">
			<ol class="music-list" id="music-list"></ol>
			<div class="music-empty" id="music-empty" hidden>
				<Icon name="material-symbols:music-off-rounded" class="text-[2rem]" />
				<p class="mt-2 text-sm">
					曲库是空的：配好 <code>src/config/musicConfig.ts</code> 后运行
					<code>pnpm music:sync</code>。
				</p>
			</div>
			<button type="button" class="music-more" id="music-more" hidden>显示更多</button>
			<p class="music-footnote">
				曲目来自 <code>public/music/library.json</code>（<code>pnpm music:sync</code> 构建期同步，
				页面运行时不请求第三方接口）；来源：<code id="music-source-detail">—</code>
			</p>
		</WidgetLayout>
	</div>
</MainGridLayout>

<audio id="music-audio" preload="metadata"></audio>

<style is:global>
	/* 盘廊与曲目列表的元素是 JS 动态创建的，拿不到 Astro 的 scope 属性，
	   所以这些规则放全局样式里，用 #music-strip / #music-list 前缀限定作用域 */
	#music-strip {
		display: flex;
		gap: 0.65rem;
		overflow-x: auto;
		padding: 0.9rem 0.15rem 0.35rem;
		scrollbar-width: thin;
	}

	#music-strip .disc-mini {
		position: relative;
		flex: none;
		width: 4.2rem;
		aspect-ratio: 1;
		border: 0;
		padding: 0;
		border-radius: 50%;
		cursor: pointer;
		background: repeating-radial-gradient(circle at 50% 50%, #0b0c10 0 2px, #15181f 2px 3px);
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08);
		transition:
			transform 220ms cubic-bezier(0.33, 0, 0.25, 1),
			box-shadow 220ms ease;
	}

	#music-strip .disc-mini img {
		position: absolute;
		inset: 30%;
		width: 40%;
		height: 40%;
		border-radius: 50%;
		object-fit: cover;
	}

	#music-strip .disc-mini[data-active="true"] {
		transform: scale(1.12);
		box-shadow:
			0 0 0 2px var(--primary),
			0 10px 20px rgba(0, 0, 0, 0.35);
	}

	#music-strip .disc-mini:hover {
		transform: translateY(-2px) scale(1.06);
	}

	#music-strip .disc-mini:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 3px;
	}

	#music-list {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	#music-list .music-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.55rem 0.7rem;
		border-radius: 0.8rem;
		cursor: pointer;
		transition: background-color 160ms ease;
		color: rgb(40, 46, 60);
	}

	html.dark #music-list .music-row {
		color: rgb(232, 238, 250);
	}

	#music-list .music-row:hover {
		background: color-mix(in oklch, var(--btn-regular-bg-hover) 80%, transparent);
	}

	#music-list .music-row[data-active="true"] {
		background: color-mix(in oklch, var(--primary) 14%, transparent);
	}

	#music-list .music-row-index {
		width: 1.6rem;
		flex: none;
		font-size: 0.7rem;
		font-variant-numeric: tabular-nums;
		color: color-mix(in oklch, currentColor 45%, transparent);
		text-align: center;
	}

	#music-list .music-row-cover {
		width: 2.2rem;
		height: 2.2rem;
		flex: none;
		border-radius: 0.45rem;
		object-fit: cover;
		background: color-mix(in oklch, currentColor 10%, transparent);
	}

	#music-list .music-row-text {
		min-width: 0;
		flex: 1;
	}

	#music-list .music-row-name {
		display: block;
		font-size: 0.86rem;
		font-weight: 600;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	#music-list .music-row-artist {
		display: block;
		font-size: 0.72rem;
		color: color-mix(in oklch, currentColor 58%, transparent);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	#music-list .music-row-state {
		flex: none;
		font-size: 0.68rem;
		color: var(--primary);
	}
</style>

<style>
	.music-hero {
		display: flex;
		align-items: center;
		gap: clamp(1.25rem, 4vw, 3rem);
		padding: clamp(0.5rem, 2vw, 1.25rem) 0;
	}

	@media (max-width: 780px) {
		.music-hero {
			flex-direction: column;
			text-align: center;
		}
	}

	.disc-stage {
		position: relative;
		flex: none;
		width: clamp(11rem, 26vw, 17rem);
		aspect-ratio: 1;
		/* 2D 正面圆盘：给唱针留出右侧空间 */
		margin-right: clamp(1.5rem, 5vw, 3rem);
	}

	.disc-shadow {
		position: absolute;
		left: 4%;
		right: 4%;
		bottom: -3%;
		height: 10%;
		border-radius: 50%;
		background: radial-gradient(closest-side, rgba(0, 0, 0, 0.5), transparent 76%);
		filter: blur(7px);
	}

	/* 盘体：正面圆盘（2D），悬停只做轻微放大，不做透视倾斜 */
	.disc {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		transition:
			transform 420ms cubic-bezier(0.33, 0, 0.25, 1),
			box-shadow 420ms ease;
		background:
			radial-gradient(circle at 32% 26%, rgba(255, 255, 255, 0.13), transparent 40%),
			repeating-radial-gradient(
				circle at 50% 50%,
				#0b0c10 0 2px,
				#14161d 2px 3px,
				#0b0c10 3px 5px
			);
		box-shadow:
			inset 0 0 0 1px rgba(255, 255, 255, 0.07),
			inset 0 0 40px rgba(0, 0, 0, 0.85),
			0 14px 30px rgba(0, 0, 0, 0.45);
	}

	.disc-stage:hover .disc {
		transform: scale(1.02);
		box-shadow:
			inset 0 0 0 1px rgba(255, 255, 255, 0.1),
			inset 0 0 40px rgba(0, 0, 0, 0.85),
			0 20px 40px rgba(0, 0, 0, 0.5);
	}

	/* 转子：播放时整盘（纹路 + 高光 + 封面）一起转，暂停时停住 */
	.disc-rotor {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		animation: music-spin 5.5s linear infinite;
		animation-play-state: paused;
		will-change: transform;
	}

	.music-hero[data-playing="true"] .disc-rotor {
		animation-play-state: running;
	}

	.disc-grooves {
		position: absolute;
		inset: 4%;
		border-radius: 50%;
		background: repeating-radial-gradient(
			circle at 50% 50%,
			rgba(255, 255, 255, 0.05) 0 1px,
			transparent 1px 3px
		);
		opacity: 0.9;
	}

	/* 一道随盘转动的反光，让旋转一眼看得出来 */
	.disc-shine {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: conic-gradient(
			from 0deg,
			rgba(255, 255, 255, 0.16) 0deg,
			rgba(255, 255, 255, 0.02) 26deg,
			transparent 60deg,
			transparent 300deg,
			rgba(255, 255, 255, 0.06) 340deg,
			rgba(255, 255, 255, 0.16) 360deg
		);
		pointer-events: none;
	}

	@keyframes music-spin {
		to {
			transform: rotate(360deg);
		}
	}

	.disc-logo {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 42%;
		aspect-ratio: 1;
		transform: translate(-50%, -50%);
		border-radius: 50%;
		overflow: hidden;
		display: grid;
		place-items: center;
		background: linear-gradient(140deg, #2a3550, #141a28);
		box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.08);
		color: rgba(220, 232, 255, 0.75);
		font-size: 1.4rem;
	}

	.disc-logo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: none;
	}

	.disc-logo img[src]:not([src=""]) {
		display: block;
	}

	.disc-logo img[src]:not([src=""]) + span {
		display: none;
	}

	/* 唱针：支点在唱片右上方外侧，arm 绕支点旋转 */
	.tonearm {
		position: absolute;
		/* 支点落在圆盘右上方外侧，臂完全不压盘 */
		left: 112%;
		top: 20%;
		width: 0;
		height: 0;
		pointer-events: none;
		z-index: 3;
	}

	.tonearm-base {
		position: absolute;
		left: -0.7rem;
		top: -0.7rem;
		width: 1.4rem;
		height: 1.4rem;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 30%, #dfe4ec, #8a919e 52%, #2b303a);
		box-shadow:
			0 0 0 3px rgba(10, 12, 18, 0.7),
			0 5px 12px rgba(0, 0, 0, 0.55);
	}

	.tonearm-arm {
		position: absolute;
		left: 0;
		top: 50%;
		width: clamp(6rem, 15vw, 9.5rem);
		height: 0.38rem;
		border-radius: 999px;
		background: linear-gradient(90deg, #e2e6ee, #a8b0be 45%, #5b6270);
		box-shadow: 0 2px 7px rgba(0, 0, 0, 0.5);
		transform-origin: 0 50%;
		/* 暂停：整条臂甩到盘外（偏右下），完全不碰盘面 */
		transform: rotate(64deg);
		transition: transform 760ms cubic-bezier(0.34, 1.35, 0.32, 1);
	}

	/* 播放：扫进来搭到盘面内侧（接近盘中心右侧） */
	/* 播放：扫到盘面上，磁头压在外圈纹路上（离标签留一点距离） */
	.music-hero[data-playing="true"] .tonearm-arm {
		transform: rotate(146deg);
	}

	.tonearm-head {
		position: absolute;
		right: -0.34rem;
		top: 50%;
		width: 1.9rem;
		height: 0.72rem;
		transform: translateY(-50%);
		border-radius: 0.2rem;
		background: linear-gradient(160deg, #4a5262, #1b1f27);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.22),
			0 3px 6px rgba(0, 0, 0, 0.55);
	}

	/* 暂停时抬起的「小支架」，让唱针停靠位置有落点 */
	.tonearm-rest {
		position: absolute;
		right: -0.15rem;
		bottom: -2.1rem;
		width: 0.5rem;
		height: 1.5rem;
		border-radius: 0.2rem;
		background: linear-gradient(180deg, #6f7684, #2f343d);
		box-shadow: 0 2px 5px rgba(0, 0, 0, 0.45);
		transform: rotate(12deg);
		transform-origin: 50% 100%;
	}

	/* 播放时支架微微让开（视觉上被臂架遮住） */
	.music-hero[data-playing="true"] .tonearm-rest {
		opacity: 0.55;
	}

	.disc-spindle {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 5.5%;
		aspect-ratio: 1;
		transform: translate(-50%, -50%);
		border-radius: 50%;
		background: radial-gradient(circle at 40% 35%, #4a4f5c, #10131a 70%);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
	}

	.music-info {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
	}

	.music-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin: 0;
		font-size: 0.74rem;
		letter-spacing: 0.04em;
		color: rgb(84, 92, 112);
	}

	:global(html.dark) .music-eyebrow {
		color: rgb(186, 198, 222);
	}

	.music-title {
		margin: 0;
		font-size: clamp(1.5rem, 3vw, 2.1rem);
		font-weight: 700;
		line-height: 1.2;
		color: rgb(26, 30, 42);
	}

	:global(html.dark) .music-title {
		color: rgb(240, 244, 252);
	}

	.music-artist {
		margin: 0;
		font-size: 0.85rem;
		color: rgb(96, 102, 120);
	}

	:global(html.dark) .music-artist {
		color: rgb(168, 178, 198);
	}

	.music-progress {
		margin-top: 0.35rem;
		max-width: 28rem;
	}

	.music-progress-track {
		display: block;
		width: 100%;
		height: 0.45rem;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: rgba(120, 130, 150, 0.28);
		cursor: pointer;
		overflow: hidden;
	}

	:global(html.dark) .music-progress-track {
		background: rgba(200, 212, 236, 0.24);
	}

	.music-progress-fill {
		display: block;
		height: 100%;
		width: 0%;
		border-radius: inherit;
		background: var(--primary);
		transition: width 120ms linear;
	}

	.music-times {
		display: flex;
		justify-content: space-between;
		margin-top: 0.3rem;
		font-size: 0.72rem;
		font-variant-numeric: tabular-nums;
		color: rgb(92, 100, 120);
	}

	:global(html.dark) .music-times {
		color: rgb(214, 224, 244);
	}

	.music-controls {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-top: 0.5rem;
	}

	.music-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.6rem;
		height: 2.6rem;
		border-radius: 999px;
		border: 1px solid rgba(90, 100, 120, 0.28);
		background: rgba(90, 100, 120, 0.08);
		color: rgb(40, 46, 60);
		cursor: pointer;
		transition:
			background-color 180ms ease,
			border-color 180ms ease,
			transform 180ms ease;
	}

	:global(html.dark) .music-btn {
		border-color: rgba(208, 220, 244, 0.32);
		background: rgba(208, 220, 244, 0.1);
		color: rgb(232, 239, 252);
	}

	.music-btn:hover {
		border-color: var(--primary);
		transform: translateY(-1px);
	}

	:global(html.dark) .music-btn:hover {
		background: rgba(208, 220, 244, 0.18);
	}

	.music-btn:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 3px;
	}

	.music-btn-primary {
		width: 3.2rem;
		height: 3.2rem;
		border-color: transparent;
		background: var(--primary);
		color: var(--on-primary, #0b1020);
	}

	.music-hint {
		margin: 0.35rem 0 0;
		font-size: 0.72rem;
		color: rgb(104, 112, 132);
	}

	:global(html.dark) .music-hint {
		color: rgb(198, 210, 234);
	}

	.music-empty {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 2rem 1rem;
		border: 1px dashed var(--card-border);
		border-radius: 0.9rem;
		text-align: center;
		color: rgb(96, 104, 124);
	}

	:global(html.dark) .music-empty {
		color: rgb(190, 200, 220);
	}

	/* 「显示更多」 */
	.music-more {
		display: block;
		width: 100%;
		margin-top: 0.6rem;
		padding: 0.6rem 0;
		border: 1px dashed rgba(90, 100, 120, 0.35);
		border-radius: 0.8rem;
		background: transparent;
		color: rgb(64, 72, 92);
		font-size: 0.78rem;
		cursor: pointer;
		transition:
			border-color 180ms ease,
			color 180ms ease,
			background-color 180ms ease;
	}

	:global(html.dark) .music-more {
		border-color: rgba(208, 220, 244, 0.3);
		color: rgb(214, 224, 244);
	}

	.music-more:hover {
		border-color: var(--primary);
		color: var(--primary);
		background: color-mix(in oklch, var(--primary) 8%, transparent);
	}

	.music-more[hidden] {
		display: none;
	}

	.music-dot {
		opacity: 0.6;
	}

	.music-footnote {
		margin: 0.75rem 0 0;
		font-size: 0.7rem;
		line-height: 1.7;
		color: rgb(96, 104, 124);
	}

	:global(html.dark) .music-footnote {
		color: rgb(178, 190, 212);
	}

	.music-footnote code {
		color: rgb(64, 72, 92);
	}

	:global(html.dark) .music-footnote code {
		color: rgb(206, 216, 238);
	}

	@media (prefers-reduced-motion: reduce) {
		.disc,
		.disc-grooves,
		.disc-mini,
		.music-btn {
			transition: none;
			animation: none;
		}
	}
</style>

<script>
	interface Track {
		id: string;
		name: string;
		artist: string;
		cover?: string;
		url: string;
	}

	async function setupMusicPage(): Promise<void> {
		const hero = document.getElementById("music-hero") as HTMLElement | null;
		const audio = document.getElementById("music-audio") as HTMLAudioElement | null;
		const list = document.getElementById("music-list");
		const strip = document.getElementById("music-strip");
		if (!hero || !audio || !list || !strip) return;
		if (hero.dataset.ready === "true") return;
		hero.dataset.ready = "true";

		const libraryUrl = hero.dataset.library ?? "/music/library.json";
		let tracks: Track[] = [];
		let index = 0;
		let ready = false;
		// 列表分页渲染：曲库可能几百首，一次只铺一页
		const PAGE_SIZE = 80;
		let visibleCount = PAGE_SIZE;

		const get = <T extends HTMLElement>(id: string): T | null =>
			document.getElementById(id) as T | null;

		const titleEl = get("music-now-title");
		const artistEl = get("music-now-artist");
		const coverEl = get("music-disc-cover") as HTMLImageElement | null;
		const initialEl = get("music-disc-initial");
		const toggleBtn = get("music-toggle");
		const playIcon = get("music-icon-play");
		const pauseIcon = get("music-icon-pause");
		const fill = get("music-progress-fill");
		const progress = get("music-progress");
		const timeCurrent = get("music-time-current");
		const timeTotal = get("music-time-total");
		const hint = get("music-hint");

		const fmt = (seconds: number): string => {
			if (!Number.isFinite(seconds) || seconds <= 0) return "0:00";
			const m = Math.floor(seconds / 60);
			const s = Math.floor(seconds % 60);
			return `${m}:${String(s).padStart(2, "0")}`;
		};

		const renderStrip = (): void => {
			strip.innerHTML = "";
			stripWindow().forEach(({ track, i }) => {
				const button = document.createElement("button");
				button.type = "button";
				button.className = "disc-mini";
				button.dataset.index = String(i);
				button.setAttribute("role", "listitem");
				button.setAttribute("aria-label", `${track.name} - ${track.artist}`);
				button.dataset.active = String(i === index);
				if (track.cover) {
					const img = document.createElement("img");
					img.src = track.cover;
					img.alt = "";
					img.loading = "lazy";
					img.referrerPolicy = "no-referrer";
					button.appendChild(img);
				}
				strip.appendChild(button);
			});
		};

		const renderList = (): void => {
			list.innerHTML = "";
			const limit = Math.min(tracks.length, visibleCount);
			tracks.slice(0, limit).forEach((track, i) => {
				const li = document.createElement("li");
				li.className = "music-row";
				li.dataset.index = String(i);
				li.dataset.active = String(i === index);
				li.tabIndex = 0;
				li.setAttribute("role", "button");
				li.setAttribute("aria-label", `播放 ${track.name}`);

				const idx = document.createElement("span");
				idx.className = "music-row-index";
				idx.textContent = String(i + 1).padStart(2, "0");

				const text = document.createElement("span");
				text.className = "music-row-text";
				const name = document.createElement("span");
				name.className = "music-row-name";
				name.textContent = track.name;
				const artist = document.createElement("span");
				artist.className = "music-row-artist";
				artist.textContent = track.artist;
				text.append(name, artist);

				const state = document.createElement("span");
				state.className = "music-row-state";
				state.textContent = i === index ? "♪" : "";

				if (track.cover) {
					const cover = document.createElement("img");
					cover.className = "music-row-cover";
					cover.src = track.cover;
					cover.alt = "";
					cover.loading = "lazy";
					cover.referrerPolicy = "no-referrer";
					li.append(idx, cover, text, state);
				} else {
					li.append(idx, text, state);
				}
				list.appendChild(li);
			});

			const more = document.getElementById("music-more");
			if (more) more.hidden = tracks.length <= limit;
		};

		/** 盘廊只铺当前曲目附近的窗口，避免几百个唱片节点 */
		const stripWindow = (): Array<{ track: Track; i: number }> => {
			const span = 8;
			const start = Math.max(0, index - span);
			const end = Math.min(tracks.length, index + span + 1);
			const out: Array<{ track: Track; i: number }> = [];
			for (let i = start; i < end; i++) {
				const track = tracks[i];
				if (track) out.push({ track, i });
			}
			return out;
		};

		const paint = (): void => {
			const track = tracks[index];
			if (!track) return;
			const countEl = document.getElementById("music-count");
			if (countEl) countEl.textContent = `${tracks.length} 首`;
			if (titleEl) titleEl.textContent = track.name;
			if (artistEl) artistEl.textContent = track.artist;
			if (initialEl) initialEl.textContent = track.name.slice(0, 1) || "♪";
			if (coverEl) {
				if (track.cover) {
					coverEl.src = track.cover;
					coverEl.alt = `${track.name} 封面`;
				} else {
					coverEl.removeAttribute("src");
				}
			}
			renderStrip();
			renderList();
		};

		const load = (play: boolean): void => {
			const track = tracks[index];
			if (!track) return;
			paint();
			if (!play) return;
			audio.src = track.url;
			ready = true;
			setPlayingUi(true);
			void audio.play().catch(() => {
				setPlayingUi(false);
				if (hint) hint.textContent = "这一首播放失败（直链可能已失效），试试下一首";
			});
		};

		const setPlayingUi = (playing: boolean): void => {
			hero.dataset.playing = String(playing);
			playIcon?.classList.toggle("hidden", playing);
			pauseIcon?.classList.toggle("hidden", !playing);
			toggleBtn?.setAttribute("aria-label", playing ? "暂停" : "播放");
			if (hint) {
				hint.textContent = playing
					? "正在播放 —— 滚轮 / ← → 切换唱片"
					: "点唱片或列表任意一首开始播放";
			}
		};

		const step = (delta: number, play = true): void => {
			index = (index + delta + tracks.length) % tracks.length;
			audio.currentTime = 0;
			load(play);
		};

		toggleBtn?.addEventListener("click", () => {
			if (!ready) {
				load(true);
				return;
			}
			if (audio.paused) void audio.play();
			else audio.pause();
		});

		get("music-prev")?.addEventListener("click", () => step(-1));
		get("music-next")?.addEventListener("click", () => step(1));

		list.addEventListener("click", (event) => {
			const row = (event.target as Element).closest<HTMLElement>(".music-row");
			if (!row?.dataset.index) return;
			index = Number(row.dataset.index);
			audio.currentTime = 0;
			load(true);
		});

		list.addEventListener("keydown", (event) => {
			if (event.key !== "Enter" && event.key !== " ") return;
			const row = (event.target as Element).closest<HTMLElement>(".music-row");
			if (!row?.dataset.index) return;
			event.preventDefault();
			index = Number(row.dataset.index);
			load(true);
		});

		strip.addEventListener("click", (event) => {
			const button = (event.target as Element).closest<HTMLElement>(".disc-mini");
			if (!button?.dataset.index) return;
			index = Number(button.dataset.index);
			load(true);
		});

		strip.addEventListener(
			"wheel",
			(event) => {
				event.preventDefault();
				step(event.deltaY > 0 ? 1 : -1);
			},
			{ passive: false },
		);

		document.addEventListener("keydown", (event) => {
			const target = event.target as HTMLElement | null;
			const tag = target?.tagName;
			if (tag === "INPUT" || tag === "TEXTAREA") return;
			if (target?.closest("button, a")) return;
			if (event.key === "ArrowRight") step(1);
			else if (event.key === "ArrowLeft") step(-1);
			else if (event.key === " ") {
				event.preventDefault();
				toggleBtn?.click();
			}
		});

		progress?.addEventListener("click", (event) => {
			const rect = progress.getBoundingClientRect();
			const ratio = (event.clientX - rect.left) / rect.width;
			if (Number.isFinite(audio.duration) && audio.duration > 0) {
				audio.currentTime = Math.max(0, Math.min(1, ratio)) * audio.duration;
			}
		});

		audio.addEventListener("timeupdate", () => {
			const ratio = audio.duration ? audio.currentTime / audio.duration : 0;
			if (fill) fill.style.width = `${Math.round(ratio * 100)}%`;
			if (timeCurrent) timeCurrent.textContent = fmt(audio.currentTime);
		});

		audio.addEventListener("loadedmetadata", () => {
			if (timeTotal) timeTotal.textContent = fmt(audio.duration);
		});

		audio.addEventListener("error", () => {
			setPlayingUi(false);
			if (hint) hint.textContent = "这一首的直链不可用（可能已被限流或过期），点下一首重试";
		});

		audio.addEventListener("play", () => setPlayingUi(true));
		audio.addEventListener("pause", () => setPlayingUi(false));
		audio.addEventListener("ended", () => step(1));

		// ── 载入曲库（自家静态 JSON） ──────────────────────────────
		try {
			const response = await fetch(libraryUrl);
			if (!response.ok) throw new Error(`HTTP ${response.status}`);
			const library = (await response.json()) as {
				source?: string;
				tracks?: Track[];
			};
			tracks = Array.isArray(library.tracks) ? library.tracks : [];
			const sourceEl = document.getElementById("music-source");
			if (sourceEl) {
				sourceEl.textContent = (library.source ?? "").startsWith("meting")
					? "在线歌单（Meting · 构建期同步）"
					: "本地曲目";
			}
			const detailEl = document.getElementById("music-source-detail");
			if (detailEl) detailEl.textContent = library.source ?? "—";
		} catch {
			if (hint) hint.textContent = "曲库载入失败：检查 public/music/library.json 是否存在";
		}

		if (tracks.length === 0) {
			const empty = document.getElementById("music-empty");
			if (empty) empty.hidden = false;
			if (hint) hint.textContent = "曲库是空的，先跑 pnpm music:sync 生成";
			return;
		}

		document.getElementById("music-more")?.addEventListener("click", () => {
			visibleCount += PAGE_SIZE;
			renderList();
		});

		paint();
		setPlayingUi(false);
	}

	void setupMusicPage();
	document.addEventListener("astro:page-load", () => {
		void setupMusicPage();
	});
</script>
