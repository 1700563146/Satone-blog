---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { photoWallConfig } from "@/config/photoWallConfig";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 照片墙：占位版。
// 版式先按「高度错落的瀑布流」定下来（列宽固定、行高按瓦片高度自然流动），
// 接真实图片时把 <div class="wall-tile"> 换成 <img> 即可，不需要重排版式。
// 只受 photoWallConfig.enable 控制（和老的 gallery 相册页相互独立）
if (!photoWallConfig.enable) {
	return Astro.redirect("/404/");
}

const { title, description, photos, placeholderCount } = photoWallConfig;
const tiles = photos.length > 0 ? photos : Array.from({ length: placeholderCount }, () => null);
// 占位瓦片的高度循环：让瀑布流看起来不是一片等高的方块
const heights = ["h-56", "h-40", "h-64", "h-44", "h-52", "h-36", "h-60", "h-48", "h-56"];
---

<MainGridLayout title={title} description={description}>
	<div class="flex flex-col gap-4">
		<WidgetLayout id="photo-wall-intro" name={title}>
			<p class="text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">{description}</p>
			<p
				class="mt-2 inline-flex items-center gap-1.5 rounded-full bg-(--btn-regular-bg) px-3 py-1 text-xs text-(--btn-content)"
			>
				<Icon name="material-symbols:construction-rounded" class="text-[0.95rem]"></Icon>
				开发中 · 版式与图片稍后补上
			</p>
		</WidgetLayout>

		<WidgetLayout id="photo-wall-grid" name="全部照片">
			<div class="wall-grid">
				{
					tiles.map((photo, index) => (
						<figure class="wall-tile" data-empty={photo ? "false" : "true"}>
							{photo ? (
								<img
									src={photo.src}
									alt={photo.caption || `照片 ${index + 1}`}
									class={`wall-media ${heights[index % heights.length]}`}
									loading="lazy"
								/>
							) : (
								<div class={`wall-media wall-tile-empty ${heights[index % heights.length]}`}>
									<Icon name="material-symbols:image-outline" class="text-[1.75rem]"></Icon>
								</div>
							)}
							<figcaption class="wall-caption">
								{photo?.caption || `待上传 ${index + 1}`}
								{photo?.meta && <span class="wall-meta">{photo.meta}</span>}
							</figcaption>
						</figure>
					))
				}
			</div>
			<p class="mt-4 text-xs leading-relaxed text-neutral-500 dark:text-neutral-400">
				占位瓦片：真正的图片放到 <code>public/wall/</code>，然后在
				<code>src/config/photoWallConfig.ts</code> 的 <code>photos</code> 里登记即可。
				之后会换成更贴合照片的表现形式（瀑布流 + 灯箱 + 懒加载）。
			</p>
		</WidgetLayout>
	</div>
</MainGridLayout>

<style>
	.wall-grid {
		/* 瀑布流：列宽自适应，瓦片高度不一自然错落 */
		column-width: 11rem;
		column-gap: 0.75rem;
	}

	.wall-tile {
		break-inside: avoid;
		margin-bottom: 0.75rem;
		border-radius: 1rem;
		overflow: hidden;
		border: 1px solid var(--card-border);
		background-color: color-mix(in oklch, var(--card-bg) 70%, transparent);
		transition:
			transform 180ms ease,
			box-shadow 180ms ease;
	}

	.wall-tile:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-card-hover);
	}

	.wall-media {
		display: block;
		width: 100%;
		object-fit: cover;
	}

	.wall-tile-empty {
		display: flex;
		align-items: center;
		justify-content: center;
		color: color-mix(in oklch, var(--primary) 55%, transparent);
		background: linear-gradient(
			135deg,
			color-mix(in oklch, var(--primary) 10%, transparent),
			color-mix(in oklch, var(--primary) 2%, transparent) 60%,
			color-mix(in oklch, var(--primary) 8%, transparent)
		);
	}

	.wall-caption {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.5rem 0.75rem;
		font-size: 0.72rem;
		color: color-mix(in oklch, currentColor 65%, transparent);
	}

	.wall-meta {
		color: color-mix(in oklch, currentColor 45%, transparent);
	}
</style>
